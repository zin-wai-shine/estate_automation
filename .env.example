# Database Configuration
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=estate_automate
DB_PORT=5432

# Redis Configuration
REDIS_ADDR=redis:6379

# API Server Configuration
API_PORT=8085
JWT_SECRET=super_secret_jwt_key_change_in_production

# Frontend Configuration
VITE_API_URL=http://localhost:8085

# Meta Graph API Configuration (Facebook Integration)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_GRAPH_VERSION=v20.0
META_OAUTH_REDIRECT_URI=http://localhost:8085/api/facebook/auth/callback

# Cloudflare R2 / S3 Object Storage Configuration
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key_here
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key_here
CLOUDFLARE_R2_BUCKET=estate-automate-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.estateautomate.com

# Public App URL & Reverse Proxy
HOST_PROXY_PORT=80
PUBLIC_APP_URL=https://app.bolthavenproperty.com

# Cloudflare Tunnel Integration
CLOUDFLARE_TUNNEL_NAME=bolthaven-docker
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Ngrok Tunnel Integration (Optional Fallback)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=valeri-sunback-janay.ngrok-free.dev

# TikTok Developer Login Kit & Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=https://app.bolthavenproperty.com/api/auth/tiktok/callback
TIKTOK_ENVIRONMENT=sandbox
