FROM mcr.microsoft.com/playwright/python:v1.40.0-jammy

ENV DEBIAN_FRONTEND=noninteractive

# Install Node.js, Xvfb, x11vnc, websockify, novnc, and browser dependencies
RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    websockify \
    novnc \
    fluxbox \
    curl \
    gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files and install Playwright
COPY package.json ./
RUN npm install

COPY scripts/ ./scripts/
COPY entrypoint.browser.sh ./entrypoint.browser.sh
RUN chmod +x ./entrypoint.browser.sh

ENV DISPLAY=:99
ENV BROWSER_PROFILES_DIR=/data/browser-profiles
ENV PYTHONUNBUFFERED=1

RUN mkdir -p /data/browser-profiles

CMD ["./entrypoint.browser.sh"]
